{
  "name": "resbrotherx-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Resbrotherx company website: a statically pre-rendered React site.",
  "scripts": {
    "dev": "node scripts/build-icons.ts && vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-icons.ts && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.ts",
    "preview": "node scripts/serve.ts",
    "lint": "eslint .",
    "images": "node scripts/make-images.ts",
    "brand": "node scripts/make-brand.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/syne": "^5.2.5",
    "@fontsource/yantramanav": "^5.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "opentype.js": "^1.3.4",
    "purgecss": "^7.0.2",
    "sharp": "^0.34.1",
    "typescript": "^5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.12"
  }
}
